{
  "name": "fingerprint-attendance",
  "version": "0.1.0",
  "description": "Desktop employee attendance system with pluggable fingerprint scanner support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.16.0"
  },
  "build": {
    "appId": "com.yourcompany.fingerprint-attendance",
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
